# ─── Seagrass Mobile Environment ───
#
# Copy this file to .env and fill in values.
#
# CONNECTIVITY GUIDE:
#   Emulator/Simulator : http://localhost:8000/api/v1 works as-is
#   Physical device    : Use one of these options:
#     Option A (Recommended): Run `npm run tunnel` — Expo prints a public URL
#     Option B: Find your LAN IP (ipconfig / ifconfig) and set:
#               EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api/v1
#     Option C: Use ngrok on the backend: `ngrok http 8000` and paste URL below

EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_CARTO_API_KEY=
