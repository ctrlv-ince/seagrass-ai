# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/seagrass

# ── S3 / MinIO Storage ───────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=seagrass-images

# ── YOLOv11 Model ────────────────────────────
YOLO_MODEL_PATH=models/seagrass_yolov11.pt

# ── Security ─────────────────────────────────
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:5173","http://localhost:8081"]

# ── App ──────────────────────────────────────
DEBUG=true
LOG_LEVEL=info
