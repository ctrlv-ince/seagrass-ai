# ── Database (Supabase PostgreSQL + PostGIS) ──
# Transaction mode pooler on port 6543 for asyncpg compatibility.
# Find these values in: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ── Supabase Platform ────────────────────────
# Dashboard → Settings → API → Project URL / service_role key
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Object Storage ───────────────────────────
# Supabase Storage is S3-compatible. Create a bucket named "seagrass-images"
# in the Supabase Dashboard → Storage. These values point to the S3-compatible
# endpoint so boto3 keeps working without code changes.
S3_ENDPOINT_URL=https://[PROJECT_REF].supabase.co/storage/v1/s3
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET_NAME=seagrass-images

# ── YOLOv11 Model ────────────────────────────
YOLO_MODEL_PATH=models/seagrass_yolov11.pt

# ── Security ─────────────────────────────────
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:5173","http://localhost:8081"]

# ── App ──────────────────────────────────────
DEBUG=true
LOG_LEVEL=info
