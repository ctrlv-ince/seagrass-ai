# ============================================================
# Seagrass Monorepo — Root .gitignore
# Python · Node · Expo · IDE · OS
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
.venv/
ENV/

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# mypy / ruff / pyright
.mypy_cache/
.ruff_cache/
.pyright/

# Jupyter
.ipynb_checkpoints

# ── Node / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Build output
web/dist/
*.tsbuildinfo

# ── Expo / React Native ─────────────────────────────────────
mobile/.expo/
mobile/android/
mobile/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ── Environment variables ────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── ML / Data ────────────────────────────────────────────────
*.pt
*.pth
*.onnx
*.weights
*.h5
*.tflite
datasets/
runs/

# ── Misc ─────────────────────────────────────────────────────
*.log
*.bak
*.tmp
*.temp
*.agents